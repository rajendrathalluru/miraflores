{
  "name": "miraflores-workpaper-ide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write app components lib tests docs *.ts *.json *.md",
    "format:check": "prettier --check app components lib tests next.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/geist-mono": "^5.2.5",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
