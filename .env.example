# Local Postgres runs embedded through PGlite; no account or key is required.
WORKPAPER_DATA_DIR=.local
# Optional: use a dedicated Supabase/Postgres database instead of embedded Postgres.
# DATABASE_URL=postgresql://...
# Never expose a database credential through NEXT_PUBLIC_* variables.

# Required for a hosted browser demo; server-only, never NEXT_PUBLIC_.
# WORKPAPER_ACCESS_USER=reviewer
# WORKPAPER_ACCESS_PASSWORD=replace-with-a-strong-secret
